{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wavefront",
  "version": "0.1.0",
  "identifier": "dev.wavefront.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Wavefront",
        "width": 1000,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "resources": {
      "../webclient": "webclient"
    }
  }
}
